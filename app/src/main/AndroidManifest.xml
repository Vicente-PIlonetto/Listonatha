<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.bstar.intl" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.iqiyi.i18n" />
        <package android:name="com.kakao.page" />
        <package android:name="com.naver.linewebtoon" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.tapastic" />
        <package android:name="com.tubitv" />
        <package android:name="com.viki.android" />
        <package android:name="com.viz.wsj.android" />
        <package android:name="com.wbd.stream" />
        <package android:name="jp.co.shueisha.mangaplus" />
        <package android:name="jp.kakao.piccoma" />
        <package android:name="jp.naver.linemanga.android" />
        <package android:name="tv.pluto.android" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ListaAnimes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ListaAnimes.Splash"
            android:windowSoftInputMode="adjustResize">
            <!-- O ícone do lançador vem dos activity-alias abaixo (um por cor). -->
            <!-- Retorno do login do AniList: listaanimes://auth#access_token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${authScheme}" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Ícones do app: só um alias fica ativo (Configurações > Aparência > Ícone). -->
        <activity-alias
            android:name=".Icon_terracota_l"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_terracota_l"
            android:roundIcon="@mipmap/ic_launcher_terracota_l">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_terracota_d"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_terracota_d"
            android:roundIcon="@mipmap/ic_launcher_terracota_d">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_azul_l"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_azul_l"
            android:roundIcon="@mipmap/ic_launcher_azul_l">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
