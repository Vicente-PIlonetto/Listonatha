<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ListaAnimes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash do sistema: o logo parado, no mesmo lugar onde a animação do app começa. -->
    <style name="Theme.ListaAnimes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ListaAnimes</item>
    </style>
</resources>
